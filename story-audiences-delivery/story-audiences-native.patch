+    'upstreamBase': '24638bc69bd083981b178dd1e7f921eebbf7fc46',
+    'buildRevision': args.build_revision,
+    'architecture': arch,
+    'simulatorRuntime': 'iOS 27.2 / iPhone 17 Simulator',
+    'sdk': info.get('DTSDKName'),
