+        isUserInteractionEnabled = false
+        background.animateOut()
+        for view in subviews where view !== background.view { view.layer.animateAlpha(from: 1, to: 0, duration: 0.15, removeOnCompletion: false) }
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) { [weak self] in self?.removeFromSuperview() }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/Account/StoryAudienceStore.swift b/submodules/TelegramCore/Sources/Account/StoryAudienceStore.swift
new file mode 100644
index 0000000000000000000000000000000000000000..4d8099c75d714f6a58f9d5a2d4e89eb63cb87686
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Account/StoryAudienceStore.swift
@@ -0,0 +1,87 @@
+import Foundation
+import SwiftSignalKit
+
+public struct StoryAudience: Codable, Equatable {
+    public var id: Int64
+    public var name: String
+    public var icon: String
+    public var colorIndex: Int
+    public var members: [Int64]
+}
+
+/// Local audience definitions. Server-facing clients can use the same definitions with
+/// their privacy adapter; the offline demo stores them in its isolated account folder.
+public final class StoryAudienceStore {
+    private static var stores: [String: StoryAudienceStore] = [:]
+    public static func forAccount(_ account: Account) -> StoryAudienceStore {
+        if let store = stores[account.basePath] { return store }
+        let store = StoryAudienceStore(path: account.basePath + "/story-audiences.json")
+        stores[account.basePath] = store
+        return store
+    }
+    public struct PublishedStory: Codable, Equatable {
+        public var id: Int32
+        public var audienceId: Int64?
+        public var base: String
+        public var members: [Int64]
+    }
+    public struct State: Codable, Equatable {
+        public var audiences: [StoryAudience] = []
+        public var selectedId: Int64?
+        public var nextColorIndex: Int = 0
+        public var stories: [PublishedStory] = []
+    }
+    public private(set) var value: State
+    private let promise: ValuePromise<State>
+    private let path: String
+    public var updated: Signal<State, NoError> { self.promise.get() }
+    public init(path: String) {
+        self.path = path
+        self.value = (try? Data(contentsOf: URL(fileURLWithPath: path))).flatMap { try? JSONDecoder().decode(State.self, from: $0) } ?? State()
+        var migrated = false
+        for index in self.value.audiences.indices {
+            let old = self.value.audiences[index].icon
+            if old == "Travel" { self.value.audiences[index].icon = "Car"; migrated = true }
+            if old == "Game" { self.value.audiences[index].icon = "Verified"; migrated = true }
+        }
+        self.promise = ValuePromise(self.value, ignoreRepeated: true)
+        if migrated { commit() }
+    }
+    public func audience(_ id: Int64?) -> StoryAudience? { self.value.audiences.first { $0.id == id } }
+    @discardableResult public func save(id: Int64?, name: String, icon: String, members: [Int64]) -> StoryAudience? {
+        let name = name.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !name.isEmpty else { return nil }
+        let old = audience(id)
+        let item = StoryAudience(id: old?.id ?? Int64.random(in: 1 ... Int64.max), name: name, icon: icon, colorIndex: old?.colorIndex ?? value.nextColorIndex, members: Array(Set(members)).sorted())
+        if let index = value.audiences.firstIndex(where: { $0.id == item.id }) { value.audiences[index] = item }
+        else { value.audiences.append(item); value.nextColorIndex += 1 }
+        if old == nil { value.selectedId = item.id }
+        for i in value.stories.indices where value.stories[i].audienceId == item.id { value.stories[i].members = item.members }
+        commit()
+        return item
+    }
+    public func select(_ id: Int64?) { value.selectedId = audience(id)?.id; commit() }
+    public func delete(_ id: Int64) {
+        value.audiences.removeAll { $0.id == id }
+        if value.selectedId == id { value.selectedId = nil }
+        for i in value.stories.indices where value.stories[i].audienceId == id {
+            value.stories[i].audienceId = nil; value.stories[i].base = "everyone"; value.stories[i].members = []
+        }
+        commit()
+    }
+    public func publish(id: Int32, base: String, members: [Int64]) {
+        value.stories.removeAll { $0.id == id }
+        value.stories.append(PublishedStory(id: id, audienceId: value.selectedId, base: base, members: members))
+        commit()
+    }
+    public func changeStory(id: Int32, audienceId: Int64?, base: String, members: [Int64]) {
+        guard let i = value.stories.firstIndex(where: { $0.id == id }) else { return }
+        value.stories[i].audienceId = audienceId; value.stories[i].base = base; value.stories[i].members = members
+        commit()
+    }
+    private func commit() {
+        // Write atomically before notifying UI observers.
+        if let data = try? JSONEncoder().encode(value) { try? data.write(to: URL(fileURLWithPath: path), options: .atomic) }
+        promise.set(value)
+    }
+}
diff --git a/submodules/TelegramCore/Sources/Account/StoryAudiencesOfflineDemo.swift b/submodules/TelegramCore/Sources/Account/StoryAudiencesOfflineDemo.swift
new file mode 100644
index 0000000000000000000000000000000000000000..542464e571f5165674dcb40e766709c4e8469775
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Account/StoryAudiencesOfflineDemo.swift
@@ -0,0 +1,87 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+import MtProtoKit
+
+// Локальные концепты: офлайн-демо без сервера (флаг запуска `--story-audiences-demo`).
+// Сеть заменяется движком, который никогда не отвечает и ничего не отправляет, а аккаунт
+// и чаты записываются прямо в Postbox. В обычных сборках без флага поведение не меняется.
+// Отдельный DEBUG-бандл design.storyaudiences.native всегда остаётся офлайн, включая запуск с иконки.
+
+/// Устанавливается приложением при старте до создания первого аккаунта.
+public var storyAudiencesOfflineDemoEnabled: Bool {
+#if DEBUG
+    return CommandLine.arguments.contains("--story-audiences-demo") || Bundle.main.bundleIdentifier == "design.storyaudiences.native"
+#else
+    return false
+#endif
+}
+
+/// MTContext сам создаёт служебные соединения (ключи, синхронизация времени) в обход движка.
+/// В офлайн-демо все его TCP-соединения идут через закрытый локальный порт и сразу обрываются.
+let storyAudiencesOfflineDemoProxySettings = MTSocksProxySettings(ip: "127.0.0.1", port: 1, username: nil, password: nil, secret: nil)
+
+final class StoryAudiencesOfflineNetworkEngine: NetworkEngine {
+    let kind: NetworkEngineKind = .mtProtoKit
+
+    func makeSession(datacenterId: Int, role: NetworkEngineSessionRole, usageCalculationInfo: MTNetworkUsageCalculationInfo?, delegate: NetworkEngineSessionDelegate?) -> NetworkEngineSession {
+        return StoryAudiencesOfflineNetworkSession(datacenterId: datacenterId, delegate: delegate)
+    }
+}
+
+private final class StoryAudiencesOfflineRequestService: NetworkEngineRequestService {
+    func add(_ request: NetworkEngineRequest) -> Disposable {
+        // Запрос принят, но ответа не будет: экраны остаются на данных из Postbox.
+        return ActionDisposable {
+            let _ = request
+        }
+    }
+}
+
+private final class StoryAudiencesOfflineNetworkSession: NetworkEngineSession {
+    let datacenterId: Int
+    let requestService: NetworkEngineRequestService = StoryAudiencesOfflineRequestService()
+    private weak var delegate: NetworkEngineSessionDelegate?
+
+    init(datacenterId: Int, delegate: NetworkEngineSessionDelegate?) {
+        self.datacenterId = datacenterId
+        self.delegate = delegate
+    }
+
+    func setPaused(_ paused: Bool) {
+        // Шапка «Чаты» без «Соединение…»: сессия сразу сообщает, что она онлайн.
+        self.delegate?.networkSessionConnectionStateChanged(NetworkEngineConnectionState(isNetworkAvailable: true, isConnected: true, isUpdatingConnectionContext: false, isPerformingServiceTasks: false, proxyAddress: nil, proxyHasConnectionIssues: false))
+    }
+
+    func setOnline(_ online: Bool) {
+    }
+
+    func addUpdateSink(_ sink: NetworkEngineUpdateSink) {
+    }
+
+    func stop() {
+    }
+
+    func movePendingRequests(to service: NetworkEngineRequestService, deadline: Double, completion: @escaping () -> Void) {
+        completion()
+    }
+}
+
+/// Тот же переход, что после настоящего входа: состояние авторизации в Postbox и смена записи
+/// аккаунта в AccountManager. `seed` наполняет Postbox демо-данными в той же транзакции.
+public func storyAudiencesOfflineDemoSignIn(accountManager: AccountManager<TelegramAccountManagerTypes>, account: UnauthorizedAccount, accountPeerId: PeerId, seed: @escaping (Transaction) -> Void) -> Signal<Void, NoError> {
+    let appliedState = account.postbox.transaction { transaction -> Void in
+        if let hole = account.postbox.seedConfiguration.initializeChatListWithHole.topLevel {
+            transaction.replaceChatListHole(groupId: .root, index: hole.index, hole: nil)
+        }
+        initializedAppSettingsAfterLogin(transaction: transaction, appVersion: account.networkArguments.appVersion, syncContacts: false)
+        seed(transaction)
+        transaction.setState(AuthorizedAccountState(isTestingEnvironment: account.testingEnvironment, masterDatacenterId: account.masterDatacenterId, peerId: accountPeerId, state: nil, invalidatedChannels: []))
+    }
+    return appliedState
+    |> mapToSignal { _ -> Signal<Void, NoError> in
+        return accountManager.transaction { transaction -> Void in
+            switchToAuthorizedAccount(transaction: transaction, account: account, isSupportUser: false)
+        }
+    }
+}
